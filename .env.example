# Copier en .env (jamais commité). Sans clé, le backend `auto` utilise le stub déterministe (hors ligne).
ANTHROPIC_API_KEY=
# auto | stub | anthropic | llamacpp | ollama
MEMORYAICM_BACKEND=auto
MEMORYAICM_MODEL=claude-sonnet-4-5
# dossier du journal, de l'index et des adaptateurs (partageable avec ACA)
MEMORYAICM_HOME=data

# Modèle local OpenAI-compatible (llama-server, LM Studio, vLLM, Ollama /v1) — règles Echo-Core
# ex. MEMORYAICM_OPENAI_BASE_URL=http://127.0.0.1:8080 ; vide ⇒ lance llama-server si MEMORYAICM_LLAMA_SERVER est donné
MEMORYAICM_OPENAI_BASE_URL=
MEMORYAICM_OPENAI_API_KEY=
MEMORYAICM_OPENAI_MODEL=local
# ex. MEMORYAICM_MODEL_PATH=C:\modeles\Qwen3-8B-Q4_K_M.gguf — doit être approuvé (model approve)
MEMORYAICM_MODEL_PATH=
# ex. MEMORYAICM_LLAMA_SERVER=C:\llama.cpp\llama-server.exe
MEMORYAICM_LLAMA_SERVER=

# Autonomie (Echo-Core) : 0 observer · 1 proposer · 2 exécuter avec confirmation · 3 routines
MEMORYAICM_AUTONOMY=3

# Embeddings : auto (Ollama si présent, sinon hachage stdlib) | hash | ollama
MEMORYAICM_EMBEDDER=auto
MEMORYAICM_EMBED_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
